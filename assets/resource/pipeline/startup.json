{
    "StartUp": {
        "post_wait_freezes": 300,
        "timeout": 60000,
        "next": [
            //"HomeFlagFirst",
            //"StartGame",
            "[JumpBack]StartGT"
        ]
    },
    "StartGT": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.bilibili.snake"
            }
        },
        "on_error": [
