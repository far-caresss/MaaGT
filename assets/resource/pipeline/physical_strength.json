        "post_delay": 1400,
        "next": [
            "RiftBloomCheck",
            "RiftBloomSkip"
        ]
    },
    "RiftBloomCheck": {
        "desc": "**弹窗里有「每日焕发 允许 N/N」→ 今天还有免费焕发次数 → 点绿色「扫荡」确认**（用户 2026-11-15 明确：有这一行就继续跑）。走 `TapUnlessConsumes` 闸门并显式 `allow_consume: true` —— 用户已授权跑；但日志仍会记下消耗（帧上实测 `-90 体力 / -10 道具`），以后要能一键停就把这个值接到界面开关上。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "ValBloomRemain"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TapUnlessConsumes",
                "custom_action_param": {
                    "button": "BtnAutoBattleSweep",
                    "consumes": "体力 + 道具",
                    "cost": "帧上实测 90(-90) 体力 / 2,865(-10) 道具",
                    "allow_consume": true
                }
            }
        },
        "post_delay": 1800,
        "next": [
            "RiftBloomDone"
        ]
    },
    "RiftBloomSkip": {
        "desc": "**弹窗里没有「每日焕发」那一行 → 今天已经跑完了 → 点「取消」关掉弹窗、正常结束**（用户 2026-11-15 明确要求：识别不到就视为今日已完成，不要报错）。用 `TapUnlessConsumes{consumes: null, optional: true}`：取消本身不消耗，`optional` 让「按钮不在」也不判失败。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TapUnlessConsumes",
                "custom_action_param": {
