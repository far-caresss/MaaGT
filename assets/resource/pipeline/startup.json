        ]
    },
    "Start1999Error": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DisableNode",
                "custom_action_param": {
                    "node_name": "Start1999"
                }
            }
        }
    },
    "DisableStart1999": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DisableNode",
                "custom_action_param": {
                    "node_name": "Start1999"
                }
            }
        }
    }
}