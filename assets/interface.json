{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaGT",
    "description": "基于 MaaFramework 的游戏自动化助手。",
    "contact": "https://github.com/far-caresss/MaaGT/issues",
    "license": "MIT",
    "welcome": "首次使用 MaaGT！请先确认模拟器已启动、游戏已登录。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/far-caresss/MaaGT",
    "version": "1.3.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "ADB",
            "label": "模拟器",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    // 可选的 agent 示例
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    // 选项：pipeline_override 只覆盖**已存在**的节点字段，不新建节点。
    // 唯一消费者是 assets/agent/pvp44.py（读 Pvp44All.custom_action_param.allow_consume）。
    "option": {
        "周常-买英雄成长觉醒石": {
            "type": "switch",
            "label": "周常 · 买英雄成长觉醒石",
            "description": "商店 →「英雄成长」→ 第一格「传说的觉醒石」（每周限购 3/3，单价 15,000 金币），数量**拉满**后购买（约 45,000 金币）。选 No 时只把数量拉满、**不点确认**。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyGrowthBuy": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "周常-忒提斯-英雄水晶": {
            "type": "switch",
            "label": "周常 · 忒提斯英雄传 · 英雄水晶×4",
            "description": "商店左侧栏滑到底 →「忒提斯英雄传」→ 第 1 格「英雄水晶 ×4」（双周限购 6/6，单价 200 坎特币），拉满后购买。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyThetisBuy1": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "周常-忒提斯-祝福之书": {
            "type": "switch",
            "label": "周常 · 忒提斯英雄传 · 祝福之书×1",
            "description": "第 2 格「祝福之书 ×1」（每周限购 15/15，单价 700 坎特币），拉满后购买。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyThetisBuy2": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "周常-忒提斯-超凡装备宝箱": {
            "type": "switch",
            "label": "周常 · 忒提斯英雄传 · 超凡专属装备宝箱",
            "description": "第 3 格「超凡专属装备宝箱」（双周限购 1/1，14,000 坎特币）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyThetisBuy3": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "周常-忒提斯-词条洗炼灵石": {
            "type": "switch",
            "label": "周常 · 忒提斯英雄传 · 词条洗炼灵石×1",
            "description": "第 4 格「词条洗炼灵石 ×1」（每周限购 1/1，950 坎特币）。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyThetisBuy4": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "周常-忒提斯-传说中的觉醒石": {
            "type": "switch",
            "label": "周常 · 忒提斯英雄传 · 传说中的觉醒石×2",
            "description": "第 5 格（第二行第一个）「传说中的觉醒石 ×2」（双周限购 6/6，单价 200 坎特币），拉满后购买。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "WeeklyThetisBuy5": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        },
        "44消耗挑战次数": {
            "type": "switch",
            "label": "44 消耗挑战次数",
            "description": "本任务原本就会把当天剩余挑战次数打完（默认 Yes，保持旧行为）。选 No 时走到 44 面板就停、不点「开始战斗」，用于只看对手/只探路。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Pvp44All": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": true
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Pvp44All": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "allow_consume": false
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    },
    "import": [
        "tasks/StartUp.json",
        "tasks/Shop.json",
        "tasks/Receive.json",
        "tasks/Physical_strength.json",
        "tasks/Guild_check-in.json",
        "tasks/Friend.json",
        "tasks/Pvp_4v4.json",
        "tasks/Guild_raid.json",
        "tasks/Weekly.json"
    ]
}