    "RiftAwakenNav": {
        "desc": "批 3 · 觉醒石（新链）。旧链 `Awakening` 保留不动。`NavTo(PageGuideRift)` 一跳到位（真机实测 PageMain →(游玩)→ PageGuide →(裂痕)→ PageGuideRift，3 步），断言通过后交给旧内部节点 `资源觉醒`（它自己点「资源/觉醒副本」子页 → 进副本 → 扫荡）。内部 39 节点一行不动（架构文档 §8 决策）。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "NavTo",
                "custom_action_param": {
                    "target": "PageGuideRift"
                }
            }
        },
        "next": [
            "RiftAwakenAssert"
        ]
    },
    "RiftAwakenAssert": {
        "desc": "点「资源觉醒」之前先确认确实在裂痕页（架构 §3.2 第 5 条）：不在就什么都不点、直接失败。",
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "AssertOnPage",
                "custom_action_param": {
